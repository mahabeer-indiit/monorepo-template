{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.mobileprovision)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/service-account*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/*.pem)",
      "Edit(**/*.p8)",
      "Edit(**/*.p12)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/allow-template-scope)",
      "Edit(**/scripts/check-template-rename.sh)",
      "Edit(**/scripts/sync-claude-settings.sh)",
      "Edit(**/.github/workflows/**)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'R=\"$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel 2>/dev/null)\"; : \"${R:=${CLAUDE_PROJECT_DIR:-.}}\"; S=\"$R/scripts/check-template-rename.sh\"; if [ -f \"$S\" ]; then CLAUDE_PROJECT_DIR=\"$R\" bash \"$S\" session-start; fi'",
            "statusMessage": "Checking template rename gate\u2026"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'R=\"$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel 2>/dev/null)\"; : \"${R:=${CLAUDE_PROJECT_DIR:-.}}\"; S=\"$R/scripts/check-template-rename.sh\"; if [ -f \"$S\" ]; then CLAUDE_PROJECT_DIR=\"$R\" bash \"$S\" prompt; fi'",
            "statusMessage": "Checking template rename gate\u2026"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'R=\"$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel 2>/dev/null)\"; : \"${R:=${CLAUDE_PROJECT_DIR:-.}}\"; S=\"$R/scripts/check-template-rename.sh\"; if [ -f \"$S\" ]; then CLAUDE_PROJECT_DIR=\"$R\" bash \"$S\" pre-write; fi'",
            "statusMessage": "Template rename gate \u2014 blocking writes\u2026"
          }
        ]
      }
    ]
  }
}
